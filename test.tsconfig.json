{
  // The extension's own settings, for the tests and the code they compile with them.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "out-test",
    // Tests index what they have just asserted exists.
    "noUncheckedIndexedAccess": false
  },
  "include": [
    "src/**/*.ts",
    "tests/**/*.ts"
  ]
}
